# Puerto de escucha del contenedor
PORT=8899

# URL del motor AceStream (si corre en el host, usar host.docker.internal:6878)
ACESTREAM_ENGINE_URL=http://host.docker.internal:6878

# URL del motor AceStream secundario a través de VPN (opcional, ej. en contenedor Gluetun o máquina remota)
ACESTREAM_VPN_ENGINE_URL=

# Segundos de búfer por detrás del directo (RFC 8216 TIME-OFFSET)
BUFFER_OFFSET_SECONDS=16.0

# Intervalo de auto-sincronización de listas M3U en horas
AUTO_SYNC_HOURS=6

# Token de GitHub (opcional, para evitar límite de peticiones de la API de GitHub al escanear repositorios)
GITHUB_TOKEN=

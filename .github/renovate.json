{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": false,
  "prHourlyLimit": 10,
  "addLabels": ["dependencies"],
  "packageRules": [
    {
      "matchFileNames": [".github/workflows/detecta_deportes.yml"],
      "enabled": false
    },
    {
      "matchPackageNames": ["protobuf", "python", "actions/setup-python"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": false
    }
  ],
  "extends": ["config:base"]
}

